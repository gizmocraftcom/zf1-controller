{
    "name": "gizmocraft/zendframework1-controller",
    "description": "Zend Framework 1 Controller component",
    "type": "library",
    "keywords": [
        "framework",
        "zf1"
    ],
    "homepage": "http://framework.zend.com/",
    "license": "BSD-3-Clause",
    "prefer-stable": true,
    "require": {
        "php": ">=8.5",
        "gizmocraft/zendframework1-exception": "^2.0.0",
        "gizmocraft/zendframework1-config": "^3.0.0",
        "gizmocraft/zendframework1-loader": "^2.0.0",
        "gizmocraft/zendframework1-registry": "^2.0.0",
        "gizmocraft/zendframework1-cache": "^2.0.0",
        "gizmocraft/zendframework1-filter": "^2.0.0",
        "gizmocraft/zendframework1-locale": "^2.0.0",
        "gizmocraft/zendframework1-session": "^3.0.0",
        "gizmocraft/zendframework1-translate": "^2.0.0",
        "gizmocraft/zendframework1-uri": "^2.0.0",
        "gizmocraft/zendframework1-view": "^2.0.0"
    },
    "autoload": {
        "psr-0": {
            "Zend_Controller_": "src/"
        }
    },
    "autoload-dev": {
        "psr-0": {
            "Zend_": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4.8",
        "phpstan/phpstan": "^2.3.7",
        "friendsofphp/php-cs-fixer": "^3.95.32",
        "phpro/grumphp-shim": "^2.27.2"
    },
    "include-path": [
        "src/"
    ],
    "archive": {
        "exclude": [
            "/tests"
        ]
    },
    "scripts": {
        "test": "phpunit",
        "test-with-coverage": "phpunit --coverage-clover=clover.xml",
        "phpstan": "phpstan analyze -c phpstan.neon --no-progress --ansi --memory-limit=768M",
        "style-check": "php-cs-fixer fix --dry-run -vv"
    },
    "suggest": {
        "ext-session": "Used in the Redirector Action Helper",
        "gizmocraft/zendframework1-controller-action-helper-autocomplete": "AutoComplete Controller Action Helpers",
        "gizmocraft/zendframework1-controller-action-helper-json": "JSON Controller Action Helper",
        "gizmocraft/zendframework1-controller-action-helper-ajaxcontext": "AjaxContext Controller Action Helpers",
        "gizmocraft/zendframework1-controller-action-helper-contextswitch": "ContextSwitch Controller Action Helpers"
    },
    "config": {
        "allow-plugins": {
            "phpro/grumphp-shim": true
        }
    }
}
